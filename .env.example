# Claude Code Pro token from `claude setup-token` after signing in to Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-haiku-5-5

# Runtime-dependent: prefer the native Claude web-search / web-fetch tools when the local
# Claude runtime exposes them; a token alone does not guarantee live web access.
ENABLE_WEB_SEARCH=true

# Optional text-only Gemini fallback. Prompts are sent to Google only when enabled
# and Claude fails before producing output. Gemini fallback does not browse the web.
ENABLE_GEMINI_FALLBACK=false
GEMINI_API_KEY=
# Gemini API key from https://aistudio.google.com/apikey.
# Free-tier Gemini also does not automatically browse the web unless the client/runtime adds a
# search tool or MCP provider; model access alone does not give web browsing.
GEMINI_MODEL=gemini-3.5-flash-lite